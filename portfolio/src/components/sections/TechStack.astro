---
import { techStack, techCategories } from '@/data/site';
---

<section id="stack" data-constellation class="relative py-20 sm:py-24 md:py-40 section-curve bg-base-surface/40 -mt-10 md:-mt-14 z-10 overflow-hidden">
  <div class="mx-auto max-w-7xl px-6 md:px-10 relative" style="z-index:1;">
    <div class="max-w-3xl mb-12 sm:mb-16 md:mb-20 reveal">
      <span class="inline-block text-xs label-eyebrow text-accent mb-4">
        02 — tech stack
      </span>
      <h2 class="font-display font-bold leading-[1.02] tracking-[-0.035em]" style="font-size: clamp(2.5rem, 6vw, 5rem);">
        the tools i reach for.
      </h2>
      <p class="mt-4 text-ink-muted text-lg leading-relaxed">
        Battle-tested in production — from FHIR pipelines on EKS to event-driven microservices on Kafka.
      </p>
    </div>

    <div class="space-y-12">
      {techCategories.map((cat) => (
        <div class="reveal">
          <div class="flex items-baseline gap-4 mb-6">
            <h3 class="font-display font-semibold text-xl text-ink">{cat}</h3>
            <span class="h-px flex-1 bg-base-border"></span>
            <span class="text-xs text-ink-dim font-mono">
              {String(techStack.filter((t) => t.category === cat).length).padStart(2, '0')}
            </span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 [perspective:900px]">
            {techStack
              .filter((t) => t.category === cat)
              .map((t) => (
                <div
                  class="tech-pill tap-press-soft group flex items-center gap-3 px-4 py-3 rounded-xl bg-white/[0.025] ring-1 ring-white/[0.06] hover:ring-accent/40 hover:bg-white/[0.04] transition-[background-color,box-shadow] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] shadow-[inset_0_1px_1px_rgba(255,255,255,0.04)]"
                >
                  <span
                    class={`${t.icon} text-xl text-ink-muted group-hover:text-accent transition-colors`}
                    aria-hidden="true"
                  ></span>
                  <span class="text-sm font-medium text-ink" data-scramble={t.name}>{t.name}</span>
                </div>
              ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- devicons font -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css"
/>
