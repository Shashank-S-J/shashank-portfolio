---
import { projects } from '@/data/site';
import type { Project } from '@/data/site';
import ProjectPipeline from '@/components/ui/ProjectPipeline.astro';

const work = projects.filter((p) => p.type === 'work');
const personal = projects.filter((p) => p.type === 'personal');

const groups: { id: string; eyebrow: string; heading: string; sub: string; items: Project[] }[] = [
  {
    id: 'work',
    eyebrow: "03 — selected work",
    heading: "things i've shipped at work.",
    sub: 'Production systems built with teams — at scale, on deadline.',
    items: work,
  },
  {
    id: 'personal',
    eyebrow: '04 — personal projects',
    heading: 'things i build for fun.',
    sub: 'Side projects, weekend experiments, and learning playgrounds.',
    items: personal,
  },
];
---

<section id="projects" class="relative section-curve bg-base-surface/30 -mt-10 md:-mt-14 z-10">
  {groups.map((g, gi) => (
    <div
      id={`projects-${g.id}`}
      class:list={[
        'relative',
        gi === 0 ? 'pt-20 sm:pt-24 md:pt-40' : 'pt-16 sm:pt-20 md:pt-28',
        gi === groups.length - 1 ? 'pb-20 sm:pb-24 md:pb-40' : 'pb-10 sm:pb-12 md:pb-16',
      ]}
    >
      <div class="mx-auto max-w-7xl px-6 md:px-10">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 sm:gap-6 mb-10 sm:mb-14 reveal">
          <div class="max-w-3xl">
            <span class="inline-block text-xs label-eyebrow text-accent mb-4">
              {g.eyebrow}
            </span>
            <h2 class="font-display font-bold leading-[1.02] tracking-[-0.035em]" style="font-size: clamp(2.5rem, 7vw, 6rem);">
              {g.heading}
            </h2>
          </div>
          <p class="text-ink-muted md:max-w-sm md:text-right">
            {g.sub}
          </p>
        </div>

        <div class="relative">
          {g.items.map((p, i) => (
            g.id === 'personal' ? (
              <div
                data-showcase-card
                data-stack-card
                data-stack-group={g.id}
                class="relative md:sticky md:top-24 mb-12 sm:mb-16 md:mb-[45vh] will-change-transform [perspective:1400px]"
                style={`z-index: ${10 + i};`}
              >
                <!-- ambient light wash (subtle, single-hue) -->
                <div class="pointer-events-none absolute -top-16 left-1/3 w-[28rem] h-[28rem] rounded-full blur-[120px] bg-[radial-gradient(circle,rgba(59,130,246,0.12),transparent_70%)]" data-showcase-float="1.4"></div>

                <!-- DOUBLE-BEZEL: outer machined shell -->
                <div class="relative rounded-[28px] md:rounded-[40px] bg-white/[0.025] ring-1 ring-white/[0.06] p-1.5 md:p-2 shadow-[0_50px_140px_-40px_rgba(0,0,0,0.85)]">
                  <article data-showcase-inner class="relative overflow-hidden rounded-[calc(28px-0.375rem)] md:rounded-[calc(40px-0.5rem)] bg-[#0d0d14] shadow-[inset_0_1px_1px_rgba(255,255,255,0.06)]">

                    <!-- top status rail -->
                    <div class="relative flex items-center justify-between px-5 sm:px-6 md:px-8 pt-4 sm:pt-5 md:pt-6 pb-3 sm:pb-4 border-b border-white/[0.05]">
                      <div class="flex items-center gap-2.5">
                        {p.live ? (
                          <>
                            <span class="relative inline-flex items-center justify-center w-2 h-2">
                              <span class="absolute inset-0 rounded-full bg-emerald-400 animate-ping opacity-50"></span>
                              <span class="relative w-2 h-2 rounded-full bg-emerald-400"></span>
                            </span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.22em] text-emerald-400/90">live · personal</span>
                          </>
                        ) : (
                          <>
                            <span class="relative inline-flex items-center justify-center w-2 h-2">
                              <span class="relative w-2 h-2 rounded-full bg-ink-dim/70"></span>
                            </span>
                            <span class="text-[10px] font-mono uppercase tracking-[0.22em] text-ink-dim">source · personal</span>
                          </>
                        )}
                      </div>
                      <div class="flex items-center gap-2 sm:gap-2.5">
                        {p.github && (
                          <a
                            href={p.github}
                            target="_blank"
                            rel="noreferrer noopener"
                            aria-label={`${p.title} — view source on GitHub`}
                            class="tap-press-firm group inline-flex items-center gap-1.5 rounded-full bg-white/[0.04] hover:bg-white/[0.08] ring-1 ring-white/[0.08] hover:ring-white/[0.18] px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.18em] text-ink/85 hover:text-ink transition-colors"
                            data-magnetic
                          >
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.13c-3.2.69-3.87-1.36-3.87-1.36-.52-1.34-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.45.11-3.02 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.18-1.18 3.18-1.18.62 1.57.23 2.73.11 3.02.73.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12v3.14c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
                            <span class="hidden sm:inline">code</span>
                          </a>
                        )}
                        {p.live && (
                          <a
                            href={p.live}
                            target="_blank"
                            rel="noreferrer noopener"
                            aria-label={`${p.title} — open live preview`}
                            class="tap-press-firm group inline-flex items-center gap-1.5 rounded-full bg-accent/15 hover:bg-accent/25 ring-1 ring-accent/40 hover:ring-accent/60 px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.18em] text-accent transition-colors"
                            data-magnetic
                          >
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="M7 17 17 7M9 7h8v8"/>
                            </svg>
                            <span>live</span>
                          </a>
                        )}
                        <span class="text-[10px] font-mono uppercase tracking-[0.22em] text-ink-dim/80 pl-1 border-l border-white/[0.08] ml-0.5">
                          {String(i + 1).padStart(2, '0')} / {String(g.items.length).padStart(2, '0')}
                        </span>
                      </div>
                    </div>

                    <div class="relative grid md:grid-cols-12 gap-5 sm:gap-6 md:gap-8 p-5 sm:p-6 md:p-7">

                      <!-- LEFT: editorial copy -->
                      <div class="md:col-span-7 relative" data-showcase-float="0.4">
                        <div class="flex flex-wrap items-center gap-2 mb-3" data-blur-fade style="--bf-delay:0ms">
                          {p.kind === 'ai' ? (
                            <span class="ai-badge inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.18em]">
                              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1"/>
                                <circle cx="12" cy="12" r="3"/>
                              </svg>
                              <span>AI · RAG · Live</span>
                            </span>
                          ) : (
                            <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[10px] font-mono uppercase tracking-[0.18em] text-accent bg-accent/10 ring-1 ring-accent/20">
                              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2 4 7v10l8 5 8-5V7z"/></svg>
                              side project
                            </span>
                          )}
                          <span class="text-[10px] font-mono uppercase tracking-[0.18em] text-ink-dim">{p.duration}</span>
                        </div>

                        <h3 class="font-display font-bold text-ink leading-[0.98] tracking-[-0.035em] mb-3" style="font-size: clamp(1.85rem, 3.6vw, 2.9rem); --bf-delay:120ms" data-blur-fade>
                          {p.title}
                        </h3>

                        <p class="font-display text-transparent bg-clip-text bg-gradient-to-r from-accent via-[#93c5fd] to-[#e2e8f0] text-base md:text-xl font-semibold leading-tight mb-3 max-w-xl" data-blur-fade style="--bf-delay:240ms">
                          {p.tagline}
                        </p>

                        <p class="text-white text-[13.5px] md:text-[14.5px] leading-[1.55] mb-4 max-w-xl" data-blur-fade style="--bf-delay:360ms">
                          {p.description}
                        </p>

                        <!-- highlights as mini bento tiles -->
                        <div class="grid sm:grid-cols-3 gap-2 mb-4">
                          {p.highlights.map((h, hi) => (
                            <div class="relative rounded-xl bg-white/[0.025] ring-1 ring-white/[0.05] p-2.5 hover:ring-accent/30 transition-[box-shadow,border-color] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]" data-blur-fade style={`--bf-delay:${480 + hi * 90}ms`}>
                              <div class="font-mono text-[10px] text-accent mb-1">/{String(hi + 1).padStart(2, '0')}</div>
                              <div class="text-[11.5px] text-ink/90 leading-snug">{h}</div>
                            </div>
                          ))}
                        </div>

                        <!-- stack chips -->
                        <div class="flex flex-wrap gap-1.5 mb-4" data-blur-fade style="--bf-delay:780ms">
                          {p.stack.map((s) => (
                            <span class="text-[10.5px] font-mono text-ink/80 bg-white/[0.03] ring-1 ring-white/[0.06] px-2 py-0.5 rounded-full">
                              {s}
                            </span>
                          ))}
                        </div>

                        <!-- CTAs with button-in-button trailing icon -->
                        <div class="flex flex-wrap items-center gap-2" data-blur-fade style="--bf-delay:900ms">
                          {p.github && (
                            <a
                              href={p.github}
                              target="_blank"
                              rel="noreferrer noopener"
                              class="tap-press group inline-flex items-center gap-3 pl-5 pr-1.5 py-1.5 rounded-full bg-white text-[#0a0a0f] text-sm font-medium transition-shadow duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-[0_10px_40px_-10px_rgba(255,255,255,0.4)]"
                              data-magnetic
                            >
                              <span>view on github</span>
                              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-[#0a0a0f] text-white transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-px">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.13c-3.2.69-3.87-1.36-3.87-1.36-.52-1.34-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.45.11-3.02 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.18-1.18 3.18-1.18.62 1.57.23 2.73.11 3.02.73.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12v3.14c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
                              </span>
                            </a>
                          )}
                          {p.live && (
                            <a
                              href={p.live}
                              target="_blank"
                              rel="noreferrer noopener"
                              class="tap-press group inline-flex items-center gap-3 pl-5 pr-1.5 py-1.5 rounded-full bg-accent text-[#0a0a0f] text-sm font-medium transition-shadow duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-[0_10px_40px_-10px_rgba(59,130,246,0.6)]"
                              data-magnetic
                            >
                              <span>live preview</span>
                              <span class="flex items-center justify-center w-8 h-8 rounded-full bg-[#0a0a0f] text-accent transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-px">↗</span>
                            </a>
                          )}
                        </div>
                      </div>

                      <!-- RIGHT: animated data-flow pipeline -->
                      <div class="md:col-span-5 relative" data-showcase-float="1.0" data-blur-fade style="--bf-delay:200ms">
                        <ProjectPipeline title={p.title} variant={p.kind === 'ai' ? 'ai' : 'event'} />
                      </div>
                    </div>
                  </article>
                </div>
              </div>
            ) : (
            <div
              data-stack-card
              data-stack-group={g.id}
              class="md:sticky md:top-24 mb-5 sm:mb-6 md:mb-8 will-change-transform"
              style={`z-index: ${10 + i};`}
            >
              <article class="relative overflow-hidden rounded-[24px] sm:rounded-[28px] md:rounded-[40px] bg-white/[0.025] ring-1 ring-white/[0.06] p-1.5 md:p-2 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.6)] md:max-h-[calc(100vh-7rem)]">
                <div class="relative overflow-hidden rounded-[calc(24px-0.375rem)] sm:rounded-[calc(28px-0.375rem)] md:rounded-[calc(40px-0.5rem)] bg-[#0d0d14] p-5 sm:p-6 md:p-8 shadow-[inset_0_1px_1px_rgba(255,255,255,0.05)]">
                <div class="absolute inset-0 opacity-30 pointer-events-none bg-[radial-gradient(ellipse_at_top_right,_rgba(59,130,246,0.14),_transparent_60%)]"></div>

                <div class="relative grid md:grid-cols-12 gap-5 sm:gap-6 md:gap-8 items-start">
                  <div class="md:col-span-5">
                    <div class="font-display font-bold text-ink-dim leading-none mb-3" style="font-size: clamp(3rem, 7vw, 6rem);">
                      {String(i + 1).padStart(2, '0')}
                    </div>
                    <div class="flex flex-wrap items-center gap-2 mb-2.5">
                      {p.featured && (
                        <span class="text-[10px] font-mono uppercase tracking-wider text-accent bg-accent/10 px-2 py-1 rounded">
                          featured
                        </span>
                      )}
                      <span class="text-[10px] font-mono uppercase tracking-wider text-ink-dim bg-white/[0.03] ring-1 ring-white/[0.08] px-2 py-1 rounded">
                        {p.type === 'work' ? 'work' : 'personal'}
                      </span>
                      <span class="text-[11px] text-ink-dim font-mono">{p.duration}</span>
                    </div>
                    <h3 class="font-display font-bold text-ink leading-[1.05] tracking-tight mb-2" style="font-size: clamp(1.5rem, 2.6vw, 2.25rem);">
                      {p.title}
                    </h3>
                    <p class="text-accent text-sm font-medium mb-3">{p.tagline}</p>
                    <p class="text-ink-muted text-sm leading-relaxed mb-4 max-w-md">{p.description}</p>

                    <ul class="space-y-1.5 mb-4">
                      {p.highlights.slice(0, 3).map((h) => (
                        <li class="flex items-start gap-2.5 text-[13px] text-ink/90 leading-snug">
                          <svg class="shrink-0 mt-1 text-accent" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg>
                          <span>{h}</span>
                        </li>
                      ))}
                    </ul>

                    <div class="flex flex-wrap gap-1.5 mb-4">
                      {p.stack.slice(0, 6).map((s) => (
                        <span class="text-[10px] font-mono text-ink-muted bg-white/[0.03] ring-1 ring-white/[0.06] px-2 py-0.5 rounded">{s}</span>
                      ))}
                    </div>

                    <div class="flex items-center gap-2">
                      {p.github && (
                        <a href={p.github} target="_blank" rel="noreferrer noopener" class="liquid-glass tap-press inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-xs text-ink hover:text-accent transition-colors" data-magnetic>
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.13c-3.2.69-3.87-1.36-3.87-1.36-.52-1.34-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.45.11-3.02 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.18-1.18 3.18-1.18.62 1.57.23 2.73.11 3.02.73.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12v3.14c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
                          github
                        </a>
                      )}
                      {p.live && (
                        <a href={p.live} target="_blank" rel="noreferrer noopener" class="tap-press inline-flex items-center gap-2 px-3.5 py-2 rounded-full bg-accent text-[#0a0a0f] text-xs font-medium hover:shadow-[0_0_24px_rgba(59,130,246,0.5)] transition-shadow" data-magnetic>
                          live ↗
                        </a>
                      )}
                    </div>
                  </div>

                  <div class="md:col-span-7 grid grid-cols-1 sm:grid-cols-5 gap-2.5 md:gap-3 h-full">
                    <div class="hidden sm:flex sm:col-span-2 sm:flex-col gap-2.5 md:gap-3">
                      <div class="relative flex-1 sm:flex-none aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-accent/20 via-base-card to-base-surface border border-white/[0.06]">
                        <div class="absolute inset-0 grid place-items-center font-mono text-xs text-ink-muted p-4 text-center">
                          {p.stack[0]}
                        </div>
                      </div>
                      <div class="relative flex-1 sm:flex-none min-h-[120px] rounded-2xl overflow-hidden bg-gradient-to-tr from-base-card via-accent/10 to-base-surface border border-white/[0.06]">
                        <div class="absolute inset-0 grid place-items-center font-mono text-xs text-ink-muted p-4 text-center">
                          {p.stack[1] ?? p.stack[0]}
                        </div>
                      </div>
                    </div>
                    <div class="sm:col-span-3 relative rounded-2xl overflow-hidden bg-gradient-to-bl from-accent/25 via-base-surface to-base-page border border-white/[0.06] min-h-[180px] sm:min-h-[200px] md:min-h-[340px]">
                      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_rgba(59,130,246,0.25),_transparent_55%)]"></div>
                      <div class="absolute bottom-4 left-4 right-4">
                        <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-accent mb-1">stack</div>
                        <div class="font-display font-semibold text-ink text-base md:text-xl leading-tight">
                          {p.stack.slice(0, 4).join(' · ')}
                        </div>
                      </div>
                      <div class="absolute top-4 right-4 grid grid-cols-3 gap-1.5">
                        {Array.from({ length: 9 }).map(() => (
                          <span class="w-1.5 h-1.5 rounded-full bg-accent/40"></span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
                </div>
              </article>
            </div>
            )
          ))}
          <div data-stack-end={g.id}></div>
        </div>
      </div>
    </div>
  ))}
</section>
