---
import { personal } from '@/data/site';
import HeroTerminal from '@/components/three/HeroTerminal';
---

<section
  id="top"
  class="relative min-h-[100svh] flex items-center overflow-hidden pt-24 sm:pt-28 md:pt-32 pb-16 sm:pb-20 md:pb-24"
>
  <!-- 1. Subtle grid texture -->
  <div
    class="absolute inset-0 -z-30 opacity-[0.05] pointer-events-none"
    style="background-image: linear-gradient(rgba(248,248,242,0.6) 1px, transparent 1px), linear-gradient(90deg, rgba(248,248,242,0.6) 1px, transparent 1px); background-size: 64px 64px;"
    aria-hidden="true"
  ></div>

  <!-- 2. Ambient color wash -->
  <div
    class="absolute inset-0 -z-20 pointer-events-none"
    aria-hidden="true"
    style="background:
      radial-gradient(ellipse at 78% 32%, rgba(59,130,246,0.18), transparent 55%),
      radial-gradient(ellipse at 12% 88%, rgba(96,165,250,0.06), transparent 55%);"
  ></div>

  <!-- 2b. Floating code glyphs (populated by motion.ts) -->
  <div
    data-hero-glyphs
    class="absolute inset-0 -z-10 pointer-events-none overflow-hidden"
    aria-hidden="true"
  ></div>

  <!-- 3. Bottom fade into next section -->
  <div
    class="absolute bottom-0 left-0 right-0 h-32 -z-10 pointer-events-none bg-gradient-to-b from-transparent to-base-page"
    aria-hidden="true"
  ></div>

  <!-- CONTENT GRID -->
  <div class="relative mx-auto max-w-7xl w-full px-6 md:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 sm:gap-12 lg:gap-10 xl:gap-16 items-center">
      <!-- LEFT: copy column (shown FIRST on mobile so visitors see name immediately) -->
      <div class="lg:col-span-6 xl:col-span-6 order-1 lg:order-1">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full liquid-glass text-[11px] sm:text-xs text-ink-muted mb-6 sm:mb-7 reveal label-eyebrow">
          <span class="relative flex h-2 w-2">
            <span class="absolute inset-0 rounded-full bg-accent animate-ping opacity-60"></span>
            <span class="relative rounded-full h-2 w-2 bg-accent"></span>
          </span>
          open to opportunities — {personal.location.toLowerCase()}
        </div>

        <h1
          data-hero-headline
          class="font-display font-bold leading-[0.95] tracking-[-0.045em] mb-5 sm:mb-7"
          style="font-size: clamp(2.25rem, 7vw, 5.25rem);"
        >
          <span class="block text-ink">{personal.name.toLowerCase()}.</span>
          <span class="block text-gradient-cool">{personal.title.toLowerCase()}.</span>
        </h1>

        <p class="text-[15px] sm:text-base md:text-lg text-ink-muted max-w-lg leading-relaxed mb-7 sm:mb-9 reveal">
          {personal.bio}
        </p>

        <div class="flex flex-wrap items-center gap-3 sm:gap-4 reveal">
          <a
            href="#projects"
            class="tap-press group inline-flex items-center gap-2 px-5 sm:px-6 py-3 sm:py-3.5 rounded-full bg-accent text-[#0a0a0f] text-sm sm:text-base font-semibold hover:shadow-[0_0_36px_rgba(59,130,246,0.55)] hover:bg-accent-hover transition-[box-shadow,background-color] duration-500 ease-[cubic-bezier(0.32,0.72,0,1)]"
            data-magnetic
          >
            view projects
            <svg class="transition-transform group-hover:translate-x-1" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>

          <button
            type="button"
            data-resume-trigger
            class="liquid-glass tap-press inline-flex items-center gap-2 px-5 sm:px-6 py-3 sm:py-3.5 rounded-full text-sm sm:text-base text-ink hover:text-accent transition-colors"
            data-magnetic
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            view resume
          </button>
        </div>

        <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-ink-dim reveal">
          <a href={`mailto:${personal.email}`} class="tap-press hover:text-ink transition-colors break-all">{personal.email}</a>
          <span class="hidden sm:block w-px h-3 bg-base-border"></span>
          <span>{personal.location.toLowerCase()}</span>
        </div>
      </div>

      <!-- RIGHT: terminal column (shown AFTER copy on mobile) -->
      <div class="lg:col-span-6 xl:col-span-6 order-2 lg:order-2 reveal">
        <div class="relative w-full h-[clamp(300px,42vh,420px)] lg:h-[clamp(440px,62vh,560px)]">
          <HeroTerminal client:only="react" />
        </div>
      </div>
    </div>
  </div>

  <!-- scroll cue (hidden on mobile to avoid overlapping terminal) -->
  <a
    href="#about"
    aria-label="Scroll to about"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 hidden lg:flex flex-col items-center gap-2 text-ink-dim hover:text-accent transition-colors z-10"
  >
    <span class="text-[10px] uppercase tracking-[0.3em]">scroll</span>
    <span class="block w-px h-10 bg-gradient-to-b from-ink-dim to-transparent animate-pulse-slow"></span>
  </a>
</section>
