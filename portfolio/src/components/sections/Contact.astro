---
import { personal, socials } from '@/data/site';

const iconMap = {
  github: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-2.13c-3.2.69-3.87-1.36-3.87-1.36-.52-1.34-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.25 3.32.95.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.45.11-3.02 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.18-1.18 3.18-1.18.62 1.57.23 2.73.11 3.02.73.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.35.78 1.05.78 2.12v3.14c0 .3.21.66.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>',
  linkedin: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0H5a5 5 0 0 0-5 5v14a5 5 0 0 0 5 5h14a5 5 0 0 0 5-5V5a5 5 0 0 0-5-5zM8 19H5V8h3v11zM6.5 6.7a1.8 1.8 0 1 1 0-3.6 1.8 1.8 0 0 1 0 3.6zM20 19h-3v-5.6c0-3.36-4-3.1-4 0V19h-3V8h3v1.76c1.4-2.59 7-2.78 7 2.48V19z"/></svg>',
  mail: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>',
  phone: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>',
  map: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>',
};
---

<section id="contact" class="relative py-20 sm:py-24 md:py-40 overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,_rgba(59,130,246,0.12),_transparent_60%)]"></div>

  <div class="mx-auto max-w-3xl px-6 md:px-10 text-center">
    <span class="inline-block text-xs label-eyebrow text-accent mb-4 reveal">
      05 — contact
    </span>
    <h2 data-magnetic-letters data-spotlight-text="let's build something resilient." class="font-display font-bold leading-[1.05] tracking-[-0.035em] mb-5 sm:mb-6 reveal" style="font-size: clamp(2.25rem, 7vw, 6rem);">
      let's build something <span class="text-gradient-cool">resilient</span>.
    </h2>
    <p class="text-[15px] sm:text-base md:text-lg text-ink-muted leading-relaxed max-w-xl mx-auto mb-8 sm:mb-10 reveal">
      Got a backend problem, a hiring need, or just want to chat about distributed systems? My inbox is open.
    </p>

    <a
      href={`mailto:${personal.email}`}
      class="tap-press group inline-flex items-center gap-2 sm:gap-3 pl-5 sm:pl-6 pr-1.5 sm:pr-2 py-1.5 sm:py-2 rounded-full bg-accent text-[#0a0a0f] text-sm sm:text-base font-semibold transition-shadow duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:shadow-[0_10px_40px_-10px_rgba(59,130,246,0.55)] mb-10 sm:mb-12 reveal max-w-full"
      data-magnetic
    >
      <span class="truncate">{personal.email}</span>
      <span class="shrink-0 flex items-center justify-center w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-[#0a0a0f] text-accent transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-px">
        <span set:html={iconMap.mail} />
      </span>
    </a>

    <div class="flex items-center justify-center gap-3 mb-8 sm:mb-10 reveal">
      {socials.map((s) => (
        <a
          href={s.href}
          target={s.href.startsWith('http') ? '_blank' : undefined}
          rel="noreferrer noopener"
          aria-label={s.label}
          class="tap-press-firm grid place-items-center w-11 h-11 sm:w-12 sm:h-12 rounded-xl border border-base-border text-ink-muted hover:text-accent hover:border-accent transition-colors"
          data-magnetic
        >
          <span set:html={iconMap[s.icon]} />
        </a>
      ))}
    </div>

    <div class="flex items-center justify-center gap-2 text-sm text-ink-dim reveal">
      <span set:html={iconMap.map} class="opacity-70" />
      <span>{personal.location}</span>
    </div>
  </div>

  <footer class="mt-16 sm:mt-20 md:mt-24 border-t border-white/[0.06]">
    <div class="mx-auto max-w-7xl px-6 md:px-10 py-6 sm:py-8 flex flex-col sm:flex-row items-center justify-between gap-2 sm:gap-3 text-xs sm:text-sm text-ink-dim text-center sm:text-left">
      <p>© {new Date().getFullYear()} {personal.name.toLowerCase()} · built with astro & gsap</p>
      <p class="font-mono text-[11px] sm:text-xs">crafted in {personal.location.split(',')[0].toLowerCase()}</p>
    </div>
  </footer>
</section>
